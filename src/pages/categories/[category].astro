---
import IndexLayout from '@/layouts/IndexLayout.astro'
import PostList from '@/components/widgets/PostList.astro'
import { themeConfig } from '@/config'
import { getSortedFilteredPosts } from '@/utils/draft'
import { getCategoryCounts, sortPosts, slugifyTaxonomy } from '@/utils/posts'

export async function getStaticPaths() {
  const posts = await getSortedFilteredPosts()

  return getCategoryCounts(posts).map(([category]) => ({
    params: { category: slugifyTaxonomy(category) },
    props: { category }
  }))
}

const { category } = Astro.props
const posts = await getSortedFilteredPosts()
const categoryPosts = sortPosts(posts.filter((post) => (post.data.category || '未分类') === category))
---

<IndexLayout title={`${category} · ${themeConfig.site.title}`} description={themeConfig.site.description}>
  <main class="taxonomy-detail">
    <h1>{category}</h1>
    <PostList posts={categoryPosts} />
  </main>
</IndexLayout>

<style>
  .taxonomy-detail h1 {
    margin: 0 0 1rem;
    font-size: 1.4rem;
  }
</style>
