---
import { themeConfig } from '@/config'
import ThemeToggle from '@/components/ui/ThemeToggle.astro'
---

<div class="floating-tools" aria-label="Page tools">
  <button id="back-to-top" class="tool-button" type="button" aria-label="Back to top" title="Back to top">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path
        d="M12 19V5m0 0-7 7m7-7 7 7"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </button>
  <button id="search-toggle" class="tool-button" type="button" aria-label="Search">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path
        d="m21 21-4.35-4.35M10.5 18a7.5 7.5 0 1 1 0-15 7.5 7.5 0 0 1 0 15Z"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </button>
  {themeConfig.general.themeToggle && <ThemeToggle />}
</div>

<div id="search-panel" class="search-panel" hidden>
  <div class="search-backdrop" data-search-close></div>
  <section class="search-dialog" role="dialog" aria-modal="true" aria-label="Search posts">
    <div class="search-head">
      <svg class="search-head-icon" width="19" height="19" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="m21 21-4.35-4.35M10.5 18a7.5 7.5 0 1 1 0-15 7.5 7.5 0 0 1 0 15Z"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      <input id="search-input" type="search" placeholder="搜索文章" autocomplete="off" />
      <button id="search-close" class="search-close" type="button" aria-label="Close search">×</button>
    </div>
    <div id="search-results" class="search-results">
      <p class="search-empty">输入关键词开始搜索</p>
    </div>
  </section>
</div>

<script is:inline>
  function bindSearch() {
    const toggle = document.getElementById('search-toggle')
    const panel = document.getElementById('search-panel')
    const close = document.getElementById('search-close')
    const input = document.getElementById('search-input')
    const results = document.getElementById('search-results')

    if (!toggle || !panel || !close || !input || !results) return
    if (toggle.dataset.searchBound) return
    toggle.dataset.searchBound = 'true'

    let posts = []
    let loaded = false

    async function loadPosts() {
      if (loaded) return
      try {
        const response = await fetch('/search.json')
        if (!response.ok) throw new Error(`Search index request failed: ${response.status}`)
        posts = await response.json()
        loaded = true
      } catch (error) {
        console.error(error)
        posts = []
        loaded = true
      }
    }

    function escapeHtml(value) {
      return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;')
    }

    function escapeRegExp(value) {
      return value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
    }

    function getTerms(query) {
      return query
        .split(/\s+/)
        .map((term) => term.trim())
        .filter(Boolean)
    }

    function highlightText(value, query) {
      const terms = getTerms(query)
      const text = String(value || '')

      if (!terms.length) return escapeHtml(text)

      const pattern = terms.map(escapeRegExp).join('|')
      const splitter = new RegExp(`(${pattern})`, 'gi')
      const matcher = new RegExp(`^(${pattern})$`, 'i')

      return text
        .split(splitter)
        .map((part) => (matcher.test(part) ? `<mark>${escapeHtml(part)}</mark>` : escapeHtml(part)))
        .join('')
    }

    function cleanText(value) {
      return String(value || '')
        .replace(/```[\s\S]*?```/g, ' ')
        .replace(/`([^`]+)`/g, '$1')
        .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
        .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
        .replace(/[>#*_~\-]/g, ' ')
        .replace(/\s+/g, ' ')
        .trim()
    }

    function excerptPost(post, query) {
      const source = cleanText([post.description, post.content].filter(Boolean).join(' '))
      if (!source) return ''

      const terms = getTerms(query.toLowerCase())
      const lowerSource = source.toLowerCase()
      const matchIndex = terms.reduce((best, term) => {
        const index = lowerSource.indexOf(term)
        return index >= 0 && (best === -1 || index < best) ? index : best
      }, -1)

      const start = matchIndex > 32 ? matchIndex - 32 : 0
      const end = Math.min(source.length, start + 150)
      const prefix = start > 0 ? '...' : ''
      const suffix = end < source.length ? '...' : ''

      return `${prefix}${source.slice(start, end)}${suffix}`
    }

    function postMeta(post) {
      return [post.date, post.category, ...(post.tags || []).map((tag) => `#${tag}`)].filter(Boolean).join(' · ')
    }

    function render(items, query) {
      if (!query) {
        results.innerHTML = '<p class="search-empty">输入关键词开始搜索</p>'
        return
      }

      if (!items.length) {
        results.innerHTML = '<p class="search-empty">没有找到相关文章</p>'
        return
      }

      results.innerHTML = items
        .slice(0, 8)
        .map((post) => {
          const excerpt = excerptPost(post, query)
          const meta = postMeta(post)

          return `
            <a class="search-result" href="${post.url}">
              <span class="search-result-title">${highlightText(post.title, query)}</span>
              ${meta ? `<small class="search-result-meta">${highlightText(meta, query)}</small>` : ''}
              ${excerpt ? `<span class="search-result-excerpt">${highlightText(excerpt, query)}</span>` : ''}
            </a>
          `
        })
        .join('')
    }

    async function search() {
      const query = input.value.trim().toLowerCase()
      const terms = getTerms(query)
      await loadPosts()

      const matched = posts.filter((post) => {
        const haystack = [post.title, post.description, post.category, ...(post.tags || []), post.content]
          .filter(Boolean)
          .join(' ')
          .toLowerCase()
        return terms.every((term) => haystack.includes(term))
      })

      render(matched, query)
    }

    async function openPanel() {
      panel.hidden = false
      document.documentElement.classList.add('search-open')
      await loadPosts()
      requestAnimationFrame(() => input.focus())
    }

    function closePanel() {
      panel.hidden = true
      document.documentElement.classList.remove('search-open')
      input.value = ''
      render([], '')
    }

    toggle.addEventListener('click', openPanel)
    close.addEventListener('click', closePanel)
    input.addEventListener('input', search)
    panel.querySelectorAll('[data-search-close]').forEach((el) => el.addEventListener('click', closePanel))

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !panel.hidden) closePanel()
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault()
        openPanel()
      }
    })
  }

  function bindBackToTop() {
    const button = document.getElementById('back-to-top')
    if (!button) return
    if (button.dataset.scrollBound) return
    button.dataset.scrollBound = 'true'

    function updateVisibility() {
      button.classList.toggle('is-visible', window.scrollY > 240)
    }

    button.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }))
    window.addEventListener('scroll', updateVisibility, { passive: true })
    updateVisibility()
  }

  document.addEventListener('astro:page-load', () => {
    bindSearch()
    bindBackToTop()
  })
</script>

<style is:global>
  .floating-tools {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 40;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    align-items: center;
  }

  .floating-tools .tool-button,
  .floating-tools .theme-toggle {
    width: 1.75rem;
    height: 1.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
    opacity: 0.85;
    transition:
      color 0.2s ease-out,
      opacity 0.2s ease-out;
  }

  #back-to-top {
    opacity: 0;
    pointer-events: none;
  }

  #back-to-top.is-visible {
    opacity: 0.85;
    pointer-events: auto;
  }

  .floating-tools .tool-button:hover,
  .floating-tools .theme-toggle:hover {
    color: var(--text-primary);
    opacity: 1;
  }

  .search-panel[hidden] {
    display: none;
  }

  .search-backdrop {
    position: fixed;
    inset: 0;
    z-index: 50;
    background: rgba(0, 0, 0, 0.28);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .search-dialog {
    position: fixed;
    left: 50%;
    top: 17vh;
    z-index: 60;
    width: min(39rem, calc(100vw - 2rem));
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .search-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3.25rem;
    box-sizing: border-box;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    box-shadow: 0 0.85rem 2.5rem rgba(0, 0, 0, 0.18);
    padding: 0 0.9rem;
  }

  .search-head-icon {
    color: var(--text-secondary);
    flex: 0 0 auto;
  }

  #search-input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--text-primary);
    font: inherit;
    padding: 0.55rem 0;
    outline: none;
  }

  .search-close {
    width: 1.75rem;
    height: 1.75rem;
    border: 0;
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
    font: inherit;
    font-size: 1.65rem;
    line-height: 1;
    opacity: 0.9;
    transition: color 0.2s ease-out;
  }

  .search-close:hover {
    color: var(--text-primary);
  }

  .search-results {
    box-sizing: border-box;
    max-height: 55vh;
    overflow: auto;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    box-shadow: 0 0.85rem 2.5rem rgba(0, 0, 0, 0.12);
    padding: 0.8rem 1rem;
  }

  .search-empty {
    margin: 0;
    color: var(--text-secondary);
  }

  .search-result {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.8rem 0;
    color: var(--text-primary);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
  }

  .search-result:first-child {
    padding-top: 0;
  }

  .search-result:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .search-result-title {
    font-size: 1rem;
    font-weight: var(--font-weight-bold);
    line-height: 1.55;
  }

  .search-result-meta,
  .search-result-excerpt {
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .search-result-excerpt {
    display: -webkit-box;
    overflow: hidden;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .search-result mark {
    color: #d97706;
    background: transparent;
    font-weight: var(--font-weight-bold);
    padding: 0;
  }

  html.search-open,
  html.search-open body {
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .floating-tools {
      right: 0.9rem;
      bottom: 0.9rem;
    }

    .search-dialog {
      top: 12vh;
    }

    .search-results {
      max-height: 58vh;
    }
  }
</style>
