# Obsidian / blog sync
# Absolute path to the posts directory inside the cloned Obsidian Vault repository.
OBSIDIAN_BLOG_SOURCE_DIR=/home/yim/obsidian_notesobsidian_notes/posts

# Optional. Defaults to ./src/content/posts.
# BLOG_POSTS_TARGET_DIR=/home/yim/flower-chiri/src/content/posts

# FastGPT sync, used in a later stage.
FASTGPT_BASE_URL=
FASTGPT_API_KEY=
FASTGPT_DATASET_ID=
FASTGPT_PARENT_ID=
FASTGPT_TRAINING_TYPE=chunk
FASTGPT_CHUNK_SETTING_MODE=auto
FASTGPT_QA_PROMPT=
FASTGPT_BLOG_BASE_URL=https://flower4night.xyz
FASTGPT_STATE_FILE=/home/yim/flower-chiri/.fastgpt-sync-state.json

# FastGPT API file library, used when creating an "API 文件库" in FastGPT.
# This token is generated by us and entered into FastGPT as the API file library authorization token.
# It is not the FastGPT OpenAPI key.
FASTGPT_FILE_API_PATH=/fastgpt-blog-files
FASTGPT_FILE_API_TOKEN=change-me-to-a-long-random-token
FASTGPT_FILE_API_POSTS_DIR=/home/yim/flower-chiri/src/content/posts

# Webhook auto deploy
BLOG_WEBHOOK_SECRET=change-me-to-a-long-random-secret
BLOG_WEBHOOK_HOST=127.0.0.1
BLOG_WEBHOOK_PORT=3210
BLOG_WEBHOOK_PATH=/github/obsidian-webhook
BLOG_WEBHOOK_BRANCH=refs/heads/main

# Deploy script options
BLOG_REPO_DIR=/home/yim/flower-chiri
NOTES_REPO_DIR=/home/yim/obsidian_notesobsidian_notes
BLOG_PULL_SELF=0
BLOG_RESTART_CONTAINER=0
BLOG_STATIC_CONTAINER=flower-chiri-static
